{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "sanity"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@components/*": ["./src/components/*"],
			"@features/*": ["./src/features/*"],
			"@i18n/*": ["./src/i18n/*"],
			"@styles/*": ["./src/styles/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@constants/*": ["./src/constants/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@mockup/*": ["./src/mockup/*"]
		}
	}
}
