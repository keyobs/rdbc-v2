---
import { sanityClient } from "sanity:client";
import type { ClubPage } from "../../../sanity/sanity.types";
import Join from "@features/join/Join";
import JoinIntro from "@features/join/JoinIntro.astro";
import { getJoinContent } from "@features/join/joinData";
import Layout from "../../layouts/Layout.astro";

const [club, content] = await Promise.all([
	sanityClient.fetch<ClubPage | null>(`*[_id == "clubPage"][0]`),
	getJoinContent(sanityClient, "en"),
]);
const data = club ?? ({} as ClubPage);
---

<Layout title="Join">
  <JoinIntro locale="en" content={content} />
  <Join data={data} content={content} locale="en" client:visible />
</Layout>
