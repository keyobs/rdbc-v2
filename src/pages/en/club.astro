---
import { sanityClient } from "sanity:client";
import type { ClubPage } from "../../../sanity/sanity.types";
import Layout from "../../layouts/Layout.astro";
import RDBC from "@features/club/RDBC";

const data: ClubPage =
	(await sanityClient.fetch(`*[_type == "clubPage"][0]`)) ?? ({} as ClubPage);
---

<Layout title="The club">
  <RDBC data={data} locale="en" client:load />
</Layout>
