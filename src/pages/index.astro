---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";

import AlertBanner from "@features/home/alert/AlertBanner.astro";
import { getHomeAlert } from "@features/home/alert/homeAlert";
import Feed from "@features/home/feed/Feed";
import { getFeedData } from "@features/home/feed/feedData";
import Hero from "@features/home/Hero.astro";
import ClubJoining from "@features/home/joining/ClubJoining";
import { getJoiningPositions } from "@features/home/joining/joiningPositions";
import LastResults from "@features/home/results/LastResults.astro";
import { useTranslations } from "@i18n/index";
import "@features/home/home.css";

const locale = "fr";
const t = useTranslations(locale).home;
const joiningPositions = await getJoiningPositions(sanityClient, locale);
const alert = await getHomeAlert(sanityClient, locale);
const feedData = await getFeedData(sanityClient);
---

<Layout title="Accueil">
  {feedData.feeds.length > 0 && (
    <section class="home-wrap home-feed" aria-label="Dernières actualités">
      <Feed feeds={feedData.feeds} spots={feedData.spots} locale={locale} client:load />
    </section>
  )}
  {alert && <AlertBanner alert={alert} locale={locale} />}
  <Hero locale={locale} />
  <ClubJoining
    positions={joiningPositions ?? []}
    title={t.join.title}
    subtitle={t.join.subtitle}
    moreLabel={t.join.more}
  />
  <LastResults locale={locale} />
</Layout>
