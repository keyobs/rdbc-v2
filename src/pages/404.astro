---
import Layout from "../layouts/Layout.astro";
import { getLocale } from "@i18n/routes";
import GhostButton from "@components/buttons/GhostButton";
import { stripBase, withBase } from "@utils/urlHandler";
import "./404.css";

const locale = getLocale(stripBase(Astro.url.pathname));
const isFr = locale === "fr";
---

<Layout title="404">
  <main class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">
      {isFr ? "Page introuvable" : "Page not found"}
    </h1>
    <p class="not-found__message">
      {isFr
        ? "Cette page n'existe pas (encore)."
        : "This page doesn't exist (yet)."}
    </p>
    <GhostButton href={withBase(isFr ? "/" : "/en/")}>
      {isFr ? "Retour à l'accueil" : "Back to home"}
    </GhostButton>
  </main>
</Layout>
