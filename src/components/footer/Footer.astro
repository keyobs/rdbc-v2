---
import InstagramLink from "@components/social/InstagramLink";
import FacebookLink from "@components/social/FacebookLink";
import "./footer.css";

const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="footer__brand">Roller Derby Bordeaux Club</span>

  <div class="footer__social">
    <InstagramLink size={24} />
    <FacebookLink size={24} />
  </div>

  <p class="footer__copy">© {year} Roller Derby Bordeaux Club — Tous droits réservés</p>
</footer>
