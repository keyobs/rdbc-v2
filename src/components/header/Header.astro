---
import { useTranslations } from "@i18n/index";
import Navigation from "@features/navigation/Navigation";
import "./header.css";

const t = useTranslations("fr");
---

<header class="header">
  <a href="/" class="header__logo">
    <img src="/assets/mummy.png" alt="Roller Derby Bordeaux Club" class="header__logo-img" width="80" height="80" />
  </a>

  <Navigation t={t.nav} client:load />
</header>
