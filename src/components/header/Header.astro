---
import { Image } from "astro:assets";
import mummyImg from "../../assets/mummy.png";
import { useTranslations } from "@i18n/index";
import Navbar from "@features/navigation/Navbar.astro";
import getSectionTitle from "@features/navigation/getSectionTitle";
import { stripBase, withBase } from "@utils/urlHandler";
import "./header.css";

const pathname = stripBase(Astro.url.pathname);
const locale = pathname.startsWith("/en") ? "en" : "fr";
const t = useTranslations(locale);
const sectionTitle = getSectionTitle(pathname, t.nav);
---

<header class="header" id="site-header">
  <div class="header__content">
    <a href={withBase("/")} class="header__logo">
      <Image
        src={mummyImg}
        alt="Roller Derby Bordeaux Club"
        class="header__logo-img"
        width={160}
        height={160}
        loading="lazy"
      />
    </a>
    <span class="header__section-title">{sectionTitle}</span>
    <Navbar t={t.nav} pathname={pathname} />
  </div>
</header>

<script>
	const header = document.getElementById("site-header");
	let lastY = window.scrollY;
	let ticking = false;

	window.addEventListener("scroll", () => {
		if (ticking) return;
		requestAnimationFrame(() => {
			const y = window.scrollY;
			if (y > lastY && y > 80) {
				header?.classList.add("header--hidden");
			} else if (y <= 0) {
				header?.classList.remove("header--hidden");
			}
			lastY = y;
			ticking = false;
		});
		ticking = true;
	}, { passive: true });
</script>
