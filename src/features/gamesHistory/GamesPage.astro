---
import { sanityClient } from "sanity:client";
import { type Locale, useTranslations } from "@i18n/index";
import { getGamesData } from "@features/games/gamesData";
import { getNextGamesByTeam, getSeason } from "@features/games/utils";
import GamesAside from "./GamesAside.astro";
import GamesResults from "./GamesResults";
import NextGames from "./NextGames";
import "./gamesPage.css";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).games;

const now = new Date();
const { results, upcoming, captions } = await getGamesData(
	sanityClient,
	locale,
	now,
);
// From the start of the day: a game of today without a known time is still upcoming
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const nextGroups = getNextGamesByTeam(upcoming, today);

// Posters and tournaments are not displayed here: keep them out of the island payload
const games = results.map(({ poster, tournament, ...game }) => game);
---

<div class="games-page">
	<h1 class="games-page__title">{t.title}</h1>

	<div class="games-page__layout">
		<div class="games-page__main">
			<NextGames groups={nextGroups} locale={locale} labels={t} />

			<section class="games-page__results" aria-labelledby="results-title">
				<h2 class="games-title" id="results-title">{t.results}</h2>
				<GamesResults
					client:load
					games={games}
					captions={captions}
					locale={locale}
					currentSeason={getSeason(now.toISOString())}
					labels={t}
				/>
			</section>
		</div>

		<GamesAside locale={locale} />
	</div>
</div>
