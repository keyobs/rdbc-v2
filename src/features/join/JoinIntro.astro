---
import type { Locale } from "@i18n/index";
import { useTranslations } from "@i18n/index";
import type { JoinContent } from "./joinContent";
import "./joinIntro.css";

interface Props {
	locale: Locale;
	content: JoinContent;
}

const { locale, content } = Astro.props;
const t = useTranslations(locale).join;
---

<div class="join-intro">
  <aside class="values" aria-label={t.values.label}>
    <p class="title">{content.values.title}</p>
    <p class="text">{content.values.text}</p>
    <ul class="tags">
      {content.values.tags.map((value) => <li>{value}</li>)}
    </ul>
  </aside>

  <header class="hero">
    <span class="eyebrow">{content.hero.eyebrow}</span>
    <h1>{content.hero.title}</h1>
    <p class="text">{content.hero.text}</p>
    <nav aria-label={t.hero.rolesNav}>
      {content.roles.map((role) => <a href={`#${role.id}`}>{role.anchor}</a>)}
    </nav>
  </header>
</div>
