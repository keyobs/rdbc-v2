---
import type { Translations } from "@i18n/index";
import { DISPLAYED_NAV_LINKS } from "./navLinks";
import ShinyButton from "@components/buttons/ShinyButton";
import LanguageSwitch from "@components/languageSwitch/LanguageSwitch.astro";
import { withBase } from "@utils/urlHandler";
import "./navbar.css";
import { getLocale, getLocalizedHref } from "@i18n/routes";

interface Props {
	t: Translations["nav"];
	pathname: string;
}

const { t, pathname } = Astro.props;
const locale = getLocale(pathname);

function isActive(href: string): boolean {
	if (href === "/" || href === "/en/")
		return pathname === href || pathname === href.slice(0, -1);
	return pathname === href || pathname.startsWith(href + "/");
}
---

<nav class="navbar" aria-label="Main navigation">
	<ul class="navbar__links" id="navbar-links">
		{DISPLAYED_NAV_LINKS.map((item, index) => (
			<li class:list={[{ "navbar__item--last": index === DISPLAYED_NAV_LINKS.length - 1 }]}><a
				href={withBase(getLocalizedHref(item.href, locale))}
				class:list={[{ "is-active": isActive(getLocalizedHref(item.href, locale)), home: item.key === "home" }]}
				aria-label={item.key === "home" ? t.homeLabel : undefined}
				aria-current={isActive(getLocalizedHref(item.href, locale)) ? "page" : undefined}
			>{t[item.key]}</a></li>
		))}
		<li><ShinyButton href={withBase(getLocalizedHref("/rejoindre", locale))}>{t.join}</ShinyButton></li>
		<li><LanguageSwitch pathname={pathname} /></li>
	</ul>
</nav>

<script>
	const list = document.getElementById("navbar-links");
	if (list) {
		const spotlight = document.createElement("div");
		spotlight.className = "navbar__spotlight";
		list.prepend(spotlight);

		const links = list.querySelectorAll<HTMLAnchorElement>(
			"a:not(.btn-shiny):not(.lang-switch__btn)",
		);
		const listRect = () => list.getBoundingClientRect();

		links.forEach((link) => {
			link.addEventListener("mouseenter", () => {
				const lr = listRect();
				const r = link.getBoundingClientRect();
				spotlight.style.setProperty("--sp-left", `${r.left - lr.left}px`);
				spotlight.style.setProperty("--sp-width", `${r.width}px`);
				spotlight.style.opacity = "1";
			});
		});

		list.addEventListener("mouseleave", () => {
			spotlight.style.opacity = "0";
		});

		let pendingLink: HTMLAnchorElement | null = null;
		let pendingTimeout: number | undefined;
		let navigationAttempt = 0;

		const clearPending = () => {
			navigationAttempt++;
			pendingLink?.classList.remove("is-pending");
			pendingLink = null;
			document.documentElement.classList.remove("is-navigating");
			window.clearTimeout(pendingTimeout);
		};

		list.addEventListener("click", (event) => {
			if (
				event.defaultPrevented || event.button !== 0 ||
				event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
			) return;
			const link = event.target instanceof Element ? event.target.closest("a") : null;
			if (!(link instanceof HTMLAnchorElement) || link.hasAttribute("download")) return;
			if (link.target && link.target !== "_self") return;
			const destination = new URL(link.href);
			if (destination.origin !== window.location.origin) return;
			if (
				destination.pathname === window.location.pathname &&
				destination.search === window.location.search
			) return;

			// Keep native navigation: another link can replace the pending destination.
			clearPending();
			pendingLink = link;
			link.classList.add("is-pending");
			document.documentElement.classList.add("is-navigating");
			// Restore feedback if a cancellation is not reported by the browser.
			pendingTimeout = window.setTimeout(clearPending, 15_000);
		});

		window.addEventListener("pagehide", clearPending);
		window.addEventListener("pageshow", (event) => {
			if (event.persisted) clearPending();
		});
		window.addEventListener("offline", clearPending);
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") clearPending();
		});
		if ("navigation" in window) {
			window.navigation.addEventListener("navigate", (event) => {
				if (!pendingLink) return;
				const attempt = navigationAttempt;
				event.signal.addEventListener("abort", () => {
					if (attempt === navigationAttempt) clearPending();
				}, { once: true });
			});
		}
	}
</script>
