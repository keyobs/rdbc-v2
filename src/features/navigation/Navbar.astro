---
import type { Translations } from "@i18n/index";
import { NAV_ITEMS } from "./navLinks";
import ShinyButton from "@components/buttons/ShinyButton";
import LanguageSwitch from "@components/languageSwitch/LanguageSwitch.astro";
import "./navbar.css";

interface Props {
	t: Translations["nav"];
	pathname: string;
}

const { t, pathname } = Astro.props;
---

<nav class="navbar" aria-label="Main navigation">
	<ul class="navbar__links">
		{NAV_ITEMS.map((item) => item.type === "separator"
			? <li aria-hidden="true"><span class="navbar__separator">|</span></li>
			: <li><a href={item.href}>{t[item.key]}</a></li>
		)}
		<li><ShinyButton href="/rejoindre">{t.join}</ShinyButton></li>
		<li><LanguageSwitch pathname={pathname} /></li>
	</ul>
</nav>
