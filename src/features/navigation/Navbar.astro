---
import type { Translations } from "@i18n/index";
import { DISPLAYED_NAV_LINKS } from "./navLinks";
import ShinyButton from "@components/buttons/ShinyButton";
import LanguageSwitch from "@components/languageSwitch/LanguageSwitch.astro";
import { withBase } from "@utils/urlHandler";
import "./navbar.css";
import { getLocale, getLocalizedHref } from "@i18n/routes";

interface Props {
	t: Translations["nav"];
	pathname: string;
}

const { t, pathname } = Astro.props;
const locale = getLocale(pathname);

function isActive(href: string): boolean {
	if (href === "/" || href === "/en/")
		return pathname === href || pathname === href.slice(0, -1);
	return pathname === href || pathname.startsWith(href + "/");
}
---

<nav class="navbar" aria-label="Main navigation">
	<ul class="navbar__links" id="navbar-links">
		{DISPLAYED_NAV_LINKS.map((item) => (
			<li><a
				href={withBase(getLocalizedHref(item.href, locale))}
				class:list={[{ "is-active": isActive(getLocalizedHref(item.href, locale)), home: item.key === "home" }]}
				aria-label={item.key === "home" ? t.homeLabel : undefined}
				aria-current={isActive(getLocalizedHref(item.href, locale)) ? "page" : undefined}
			>{t[item.key]}</a></li>
		))}
		<li><ShinyButton href={withBase(getLocalizedHref("/rejoindre", locale))}>{t.join}</ShinyButton></li>
		<li><LanguageSwitch pathname={pathname} /></li>
	</ul>
</nav>

<script>
	const list = document.getElementById("navbar-links");
	if (list) {
		const spotlight = document.createElement("div");
		spotlight.className = "navbar__spotlight";
		list.prepend(spotlight);

		const links = list.querySelectorAll<HTMLAnchorElement>(
			"a:not(.btn-shiny):not(.lang-switch__btn)",
		);
		const listRect = () => list.getBoundingClientRect();

		links.forEach((link) => {
			link.addEventListener("mouseenter", () => {
				const lr = listRect();
				const r = link.getBoundingClientRect();
				spotlight.style.setProperty("--sp-left", `${r.left - lr.left}px`);
				spotlight.style.setProperty("--sp-width", `${r.width}px`);
				spotlight.style.opacity = "1";
			});
		});

		list.addEventListener("mouseleave", () => {
			spotlight.style.opacity = "0";
		});
	}
</script>
