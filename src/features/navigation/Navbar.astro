---
import type { Translations } from "@i18n/index";
import { NAV_ITEMS } from "./navLinks";
import "./navbar.css";

interface Props {
	t: Translations["nav"];
}

const { t } = Astro.props;
---

<nav class="navbar" aria-label="Main navigation">
	<ul class="navbar__links">
		{NAV_ITEMS.map((item) => item.type === "separator"
			? <li aria-hidden="true"><span class="navbar__separator">|</span></li>
			: <li><a href={item.href}>{t[item.key]}</a></li>
		)}
		<li><a href="/rejoindre" class="navbar__cta">{t.join}</a></li>
	</ul>
</nav>
