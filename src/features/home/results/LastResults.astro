---
import { sanityClient } from "sanity:client";
import { type Locale, useTranslations } from "@i18n/index";
import { getGamesData } from "@features/games/gamesData";
import { getGroupedResults, getSeason } from "@features/games/utils";
import { TEAM_TITLES } from "@features/gamesHistory/teams";
import ResultRow from "./ResultRow";
import "./lastResults.css";

interface Props {
	locale: Locale;
}

// Travel teams only: intraleague results stay on the Matchs page
const HOME_RESULTS_TEAMS = ["A", "B"] as const;

const { locale } = Astro.props;
const t = useTranslations(locale).home;

const now = new Date();
const { results, captions } = await getGamesData(sanityClient, locale, now);
const currentCaptions = captions[getSeason(now.toISOString())];
const grouped = getGroupedResults(results, true);
const boards = HOME_RESULTS_TEAMS.map((team) => ({
	title: TEAM_TITLES[team],
	caption: currentCaptions?.[team],
	games: grouped[team],
})).filter((board) => board.games.length > 0);
---

<section class="home-wrap last-results" aria-labelledby="results-title">
	<h2 class="last-results__title" id="results-title">{t.latestResults}</h2>

	{boards.map((board) => (
		<div class="results-board">
			<div class="results-board__band">{board.title}</div>
			{board.caption && <p class="results-board__caption">{board.caption}</p>}

			{board.games.map((game) => (
				<ResultRow game={game} locale={locale} />
			))}
		</div>
	))}
</section>
