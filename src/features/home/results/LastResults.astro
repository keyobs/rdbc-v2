---
import { type Locale, useTranslations } from "@i18n/index";
import { RESULTS } from "@features/games/resultsData";
import { getGroupedResults } from "@features/games/utils";
import ResultRow from "./ResultRow";
import { TEAM_BOARDS } from "./teamBoards";
import "./lastResults.css";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).home;

const grouped = getGroupedResults(RESULTS, true);
const boards = TEAM_BOARDS.map((board) => ({
	...board,
	games: grouped[board.team],
})).filter((board) => board.games.length > 0);
---

<section class="home-wrap last-results" aria-labelledby="results-title">
	<h2 class="last-results__title" id="results-title">{t.latestResults}</h2>

	{boards.map((board) => (
		<div class="results-board">
			<div class="results-board__band">{board.title}</div>
			<p class="results-board__caption">{board.caption[locale]}</p>

			{board.games.map((game) => (
				<ResultRow game={game} locale={locale} />
			))}
		</div>
	))}
</section>
