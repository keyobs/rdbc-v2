---
import "@fontsource/inter";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/animations.css";
import { getImage } from "astro:assets";
import mummyRaw from "../assets/mummy.png";
import { useTranslations } from "@i18n/index";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import BottomNav from "@features/navigation/mobile/BottomNav";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Roller Derby Bordeaux Club" } = Astro.props;
const t = useTranslations("fr");
const pathname = Astro.url.pathname;
const logoImg = await getImage({
	src: mummyRaw,
	width: 104,
	height: 104,
	format: "webp",
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — RDBC</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BottomNav t={t.nav} pathname={pathname} logoSrc={logoImg.src} client:load />
  </body>
</html>
